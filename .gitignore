# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules_old
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build


# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch scripts
/scratch

# Local SQLite databases are no longer supported. We use Supabase Postgres
# for both dev and prod. Any *.db files here would be leftover local data.
*.db
*.db.local-backup
*.db-journal

# deployments and zips
*.zip
/deploy.zip
deploy.zip

# local media uploads
/public/uploads/

